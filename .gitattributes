# Keep development files out of the Composer/Packagist dist and GitHub "Download ZIP".
/tests	export-ignore
/docs	export-ignore
/.github	export-ignore
/.claude	export-ignore
/.gitattributes	export-ignore
/.gitignore	export-ignore
/phpcs.xml.dist	export-ignore
/phpstan.neon.dist	export-ignore
/phpstan-baseline.neon	export-ignore
/phpstan-bootstrap.php	export-ignore
/phpunit.xml.dist	export-ignore
/bin	export-ignore
/strauss.phar	export-ignore
# Official EU/Inter files must stay byte-identical (sha256 CI gate): never convert line endings.
/assets/notice/**	-text
/assets/garan/**	-text
/assets/fonts/**	-text
/assets/CHECKSUMS.sha256	-text
